# Maintainer: iprjkt <iprjkt@users.noreply.github.com>
pkgname=dna-linux
pkgver=0.1.0
pkgrel=1
pkgdesc="Native Linux (x86_64) Android ROM unpack, repack, format conversion, and patch toolkit"
arch=('x86_64')
url="https://github.com/iprjkt/DNA-Android-Linux"
license=('GPL-3.0-or-later')
depends=(
    'python>=3.11'
    'python-click>=8.0'
    'python-rich>=12.0'
    'android-tools'
    'e2fsprogs'
    'erofs-utils'
    'brotli'
    'zstd'
)
optdepends=(
    'python-pyqt6: Desktop graphical user interface (GUI)'
    'apktool: Framework services.jar smali decompile & recompile'
    'avbtool: Verified Boot 2.0 image inspection'
    'f2fs-tools: Flash-Friendly File System inspection'
)
makedepends=(
    'cmake'
    'ninja'
    'gcc'
    'python-pybind11'
    'python-build'
    'python-installer'
    'python-hatchling'
    'python-wheel'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
    cd "$srcdir/dna_linux-$pkgver" 2>/dev/null || cd "$srcdir/$pkgname-$pkgver" 2>/dev/null || cd "$srcdir/DNA-Android-Linux" 2>/dev/null || cd "$startdir"
    # Build native C++ backend engine
    cmake -B build -G Ninja -DCMAKE_BUILD_TYPE=Release
    cmake --build build --parallel
    python -m build --wheel --no-isolation
}

package() {
    cd "$srcdir/dna_linux-$pkgver" 2>/dev/null || cd "$srcdir/$pkgname-$pkgver" 2>/dev/null || cd "$startdir"
    python -m installer --destdir="$pkgdir" dist/*.whl

    # Native CLI executable
    if [ -f build/dna_native_cli ]; then
        install -Dm755 build/dna_native_cli "$pkgdir/usr/bin/dna-native"
    fi

    # Native Python extension module
    py_ver=$(python3 -c "import sys; print(f'{sys.version_info.major}.{sys.version_info.minor}')")
    for so_file in dna_core/dna_core_cpp*.so; do
        if [ -f "$so_file" ]; then
            install -Dm755 "$so_file" "$pkgdir/usr/lib/python${py_ver}/site-packages/dna_core/$(basename "$so_file")"
        fi
    done

    # Desktop entry & Icon
    install -Dm644 data/dna.desktop "$pkgdir/usr/share/applications/dna.desktop"
    install -Dm644 data/icons/dna.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/dna.svg"
    install -Dm644 data/icons/dna.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/dna.png"

    # Man page
    if [ -f man/dna.1 ]; then
        install -Dm644 man/dna.1 "$pkgdir/usr/share/man/man1/dna.1"
    fi

    # Shell completions
    if [ -f completions/dna.bash ]; then
        install -Dm644 completions/dna.bash "$pkgdir/usr/share/bash-completion/completions/dna"
    fi
    if [ -f completions/_dna ]; then
        install -Dm644 completions/_dna "$pkgdir/usr/share/zsh/site-functions/_dna"
    fi
    if [ -f completions/dna.fish ]; then
        install -Dm644 completions/dna.fish "$pkgdir/usr/share/fish/vendor_completions.d/dna.fish"
    fi

    # Bundled data assets
    install -d "$pkgdir/usr/share/dna-linux/data"
    cp -r data/* "$pkgdir/usr/share/dna-linux/data/"
}
